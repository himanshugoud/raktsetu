# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/raktsetu?retryWrites=true&w=majority

# Secret used to sign JWT auth tokens - use a long random string
JWT_SECRET=change_this_to_a_long_random_string

# Port the API server listens on
PORT=5000

# Gmail address used to send emergency alert emails
GMAIL_USER=youraddress@gmail.com

# Gmail App Password (NOT your normal password) - generate at
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# URL of the deployed frontend, used in CORS + email links
CLIENT_URL=http://localhost:5173
